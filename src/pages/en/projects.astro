---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/site/Footer.astro';
import Header from '../../components/site/Header.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import { getProjectsPageContent } from '../../data/projects';

const locale = 'en' as const;
const page = getProjectsPageContent(locale);
---

<BaseLayout locale={locale} title={page.meta.title} description={page.meta.description}>
  <main class="site-shell projects-shell">
    <Header locale={locale} navItems={page.navItems} currentPath={Astro.url.pathname} />

    <section class="section projects-section">
      <div class="projects-grid">
        {page.projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </main>
  <Footer navItems={page.navItems} footer={page.footer} />
</BaseLayout>
