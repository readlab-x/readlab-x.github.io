---
import type { Locale } from '../../i18n/config';
import type { ProjectDetailContent, ProjectsPageContent } from '../../data/projects';
import ButtonLink from '../site/ButtonLink.astro';
import Footer from '../site/Footer.astro';
import Header from '../site/Header.astro';

interface Props {
  locale: Locale;
  page: ProjectsPageContent;
  project: ProjectDetailContent;
  currentPath?: string;
}

const { locale, page, project, currentPath = '/' } = Astro.props as Props;
---

<main class="site-shell project-detail-shell">
  <Header locale={locale} navItems={page.navItems} currentPath={currentPath} />

  <section class="section project-detail-hero">
    <div class="project-detail-hero__main">
      <p class="eyebrow">{project.eyebrow}</p>
      <h1>{project.title}</h1>
      <p class="lede">{project.headline}</p>
      <p class="project-detail-hero__summary">{project.summary}</p>
      <div class="hero-actions">
        <ButtonLink href={project.backHref} variant="secondary">
          {project.backLabel}
        </ButtonLink>
      </div>
    </div>

    <aside class="project-detail-hero__aside">
      <div class="project-card__meta project-detail-hero__meta">
        <span>{project.status}</span>
        <span>{project.year}</span>
      </div>
      <ul class="project-card__tags" aria-label={`${project.title} tags`}>
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <dl class="project-metrics">
        {project.metrics.map((metric) => (
          <div class="project-metrics__item">
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="section project-detail-body">
    <div class="project-detail-body__intro">
      <p class="eyebrow">{project.overviewTitle}</p>
      <div class="project-detail-copy">
        {project.overview.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="project-detail-sections">
      {project.sections.map((section) => (
        <article class="project-detail-section">
          <h2>{section.title}</h2>
          <div class="project-detail-copy">
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</main>
<Footer navItems={page.navItems} footer={page.footer} />
