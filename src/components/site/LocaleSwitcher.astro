---
import type { Locale } from '../../i18n/config';
import { getLocalePath } from '../../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const locales = [
  { code: 'zh-CN' as const, label: '中文' },
  { code: 'en' as const, label: 'EN' }
];
---

<nav class="locale-switcher" aria-label="Language switcher">
  {locales.map((item) => (
    <a
      class:list={['locale-switcher__item', { 'is-active': item.code === locale }]}
      href={getLocalePath(item.code)}
      aria-current={item.code === locale ? 'page' : undefined}
      aria-label={item.code === 'zh-CN' ? 'Switch to Chinese' : 'Switch to English'}
      title={item.code === 'zh-CN' ? 'Switch to Chinese' : 'Switch to English'}
      lang={item.code}
    >
      {item.label}
    </a>
  ))}
</nav>
