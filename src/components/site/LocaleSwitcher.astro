---
import type { Locale } from '../../i18n/config';
import { getLocalizedPath } from '../../utils/i18n';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props as Props;
const locales = [
  { code: 'zh-CN' as const, label: '中文' },
  { code: 'en' as const, label: 'EN' }
];
---

<label class="locale-switcher" aria-label="Language switcher">
  <span class="sr-only">Language</span>
  <select class="locale-switcher__select" data-locale-switcher>
    {locales.map((item) => (
      <option
        value={getLocalizedPath(item.code, currentPath)}
        selected={item.code === locale}
        lang={item.code}
      >
        {item.label}
      </option>
    ))}
  </select>
</label>

<script>
  document.querySelectorAll('[data-locale-switcher]').forEach((node) => {
    if (!(node instanceof HTMLSelectElement)) return;

    const handleChange = () => {
      if (node.value) {
        window.location.href = node.value;
      }
    };

    node.addEventListener('change', handleChange);
    window.addEventListener(
      'pagehide',
      () => {
        node.removeEventListener('change', handleChange);
      },
      { once: true }
    );
  });
</script>
