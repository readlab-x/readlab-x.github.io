---
import Button from '../starwind/button/Button.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  rel?: string;
}

const { href, variant = 'primary', external = false, rel } = Astro.props as Props;
---

<Button
  as="a"
  href={href}
  variant={variant}
  target={external ? '_blank' : undefined}
  rel={external ? rel ?? 'noreferrer' : rel}
  class="button"
>
  <slot />
</Button>
