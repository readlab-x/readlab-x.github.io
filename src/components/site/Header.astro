    ---
import NavigationMenu from '../starwind/navigation-menu/NavigationMenu.astro';
import NavigationMenuItem from '../starwind/navigation-menu/NavigationMenuItem.astro';
import NavigationMenuLink from '../starwind/navigation-menu/NavigationMenuLink.astro';
import NavigationMenuList from '../starwind/navigation-menu/NavigationMenuList.astro';
import type { Locale } from '../../i18n/config';
import { getLocalePath } from '../../utils/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Github from '@tabler/icons/outline/brand-github.svg';

interface Props {
  locale: Locale;
  navItems: Array<{ href: string; label: string }>;
  currentPath?: string;
  overlay?: boolean;
}

const { locale, navItems, currentPath = '/', overlay = false } = Astro.props as Props;
const brandHref = getLocalePath(locale);
const hasNavItems = navItems.length > 0;

function isActive(href: string) {
  if (href.startsWith('#')) {
    return false;
  }

  const normalizedCurrentPath = currentPath.replace(/\/$/, '') || '/';
  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return normalizedCurrentPath === '/';
  }

  return normalizedCurrentPath === normalizedHref || normalizedCurrentPath.startsWith(`${normalizedHref}/`);
}
---

<header class:list={['site-header', overlay && 'site-header--overlay']} data-site-header>
  <div class="topbar site-header__inner">
    <a
      class:list={['brand', overlay && 'brand--reveal-on-scroll']}
      href={brandHref}
      aria-label="ReadLab X home"
    >
      <img src="/brand/logo-wordmark.png" alt="" />
    </a>
    {hasNavItems && (
      <NavigationMenu class="topnav site-header__nav" aria-label="Primary navigation" disablePortal>
        <NavigationMenuList>
          {navItems.map((item) => (
            <NavigationMenuItem>
              <NavigationMenuLink href={item.href} active={isActive(item.href)}>
                {item.label}
              </NavigationMenuLink>
            </NavigationMenuItem>
          ))}
        </NavigationMenuList>
      </NavigationMenu>
    )}
    <div class:list={['topbar-actions', 'site-header__actions', !hasNavItems && 'site-header__actions--compact']}>
      <LocaleSwitcher locale={locale} currentPath={currentPath} />
      <ThemeToggle />
      <a
        class="github-link"
        href="https://github.com/readlab-x"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <Github aria-hidden="true" />
      </a>
    </div>
  </div>
</header>

<script>
  const headers = Array.from(document.querySelectorAll('[data-site-header]'));

  headers.forEach((header) => {
    if (!(header instanceof HTMLElement)) return;

    const updateHeaderState = () => {
      header.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
    };

    updateHeaderState();
    window.addEventListener('scroll', updateHeaderState, { passive: true });
    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('scroll', updateHeaderState);
      },
      { once: true }
    );
  });
</script>
