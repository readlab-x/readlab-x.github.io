---
import type { Locale } from '../../i18n/config';
import type { HomeMessages } from '../../i18n/messages/en';
import { getLocalizedHref } from '../../utils/i18n';
import Footer from './Footer.astro';
import Header from './Header.astro';
import ParticleLogo from './ParticleLogo.astro';

interface Props {
  locale: Locale;
  messages: HomeMessages;
  currentPath?: string;
}

const { locale, messages, currentPath = '/' } = Astro.props as Props;
const {
  hero,
  projectPreview,
  navItems,
  footer
} = messages;
const projectArchiveHref = getLocalizedHref(locale, projectPreview.primaryCta.href);
const [currentProject] = projectPreview.items;
---

<main class="site-shell">
  <Header locale={locale} navItems={navItems} currentPath={currentPath} overlay />

  <section class="home-splash" aria-label="ReadLab X">
    <div class="home-splash__particle-wrap">
      <ParticleLogo class="home-splash__particle" align="top-left" scale={1.08} />
    </div>
    <div class="home-splash__name">
      <p>ReadLab <span class="home-splash__name-accent">X</span></p>
    </div>
  </section>

  <section class="home-content">
    <section class="section project-preview project-preview--splash" id="projects">
      <div class="project-preview__backdrop" aria-hidden="true"></div>

      <article class="project-preview-feature">
        <div class="project-preview-feature__heading">
          <p class="eyebrow">{projectPreview.eyebrow}</p>
          <div class="project-card__meta">
            <span>{currentProject.status}</span>
          </div>
          <h3 class="project-card__title">{currentProject.title}</h3>
          <p class="project-card__copy">{currentProject.summary}</p>
        </div>

        <div class="project-preview-feature__rail">
          <p class="project-preview__copy">{projectPreview.copy}</p>
          <div class="project-preview-feature__tags">
            <p class="project-preview-feature__label">{projectPreview.note}</p>
            <ul class="project-card__tags" aria-label={`${currentProject.title} tags`}>
              {currentProject.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>

          <div class="project-preview__footer project-preview__footer--stacked">
            <a class="project-action project-action--secondary" href={projectArchiveHref}>
              {projectPreview.primaryCta.label}
            </a>
            <a class="project-action project-action--primary" href={hero.secondaryCta.href}>
              {hero.secondaryCta.label}
            </a>
          </div>
        </div>
      </article>
    </section>
  </section>
</main>
<Footer navItems={navItems} footer={footer} />
